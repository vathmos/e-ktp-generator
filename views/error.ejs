<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - E-KTP Generator Indonesia</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css?v=6">
</head>

<body>
    <header class="topbar">
        <a class="brand" href="/"><i class="bi bi-person-badge"></i>E-KTP Generator</a>
        <nav class="topbar-actions">
            <a class="navlink" href="/"><i class="bi bi-house-door"></i><span>Beranda</span></a>
            <a class="navlink" href="https://github.com/vathmos/e-ktp-generator" target="_blank"><i class="bi bi-github"></i><span>GitHub</span></a>
            <button type="button" class="icon-btn" id="themeToggle" aria-label="Ganti tema"><i class="bi bi-moon-stars"></i></button>
        </nav>
    </header>

    <main class="page">
        <section class="block centered" style="margin: 2rem auto;">
            <i class="bi bi-x-circle-fill error-icon"></i>
            <h2 style="margin: 1rem 0;">Terjadi Kesalahan</h2>
            <p class="subtitle" style="margin-bottom: 1.5rem;"><%= message %></p>
            <a href="/" class="btn btn-primary"><i class="bi bi-house-door"></i>Kembali ke Halaman Utama</a>
        </section>
    </main>

    <footer class="footer">
        Created by <a href="https://github.com/YoshCasaster" target="_blank">CodeFomo &amp; Yosh Casaster</a> &middot; Enhanced by <a href="https://github.com/vathmos" target="_blank">vathmos</a>
    </footer>

    <script src="/js/script.js?v=6"></script>
</body>
</html>
