<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-KTP Generator Indonesia</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/YoshCasaster/store_db/refs/heads/main/Template.png">
    <link rel="apple-touch-icon" href="https://raw.githubusercontent.com/YoshCasaster/store_db/refs/heads/main/Template.png">

    <!-- Meta SEO -->
    <meta name="description" content="Buat E-KTP Indonesia secara otomatis dan mudah secara online.">
    <meta name="keywords" content="E-KTP, Generator KTP, KTP Online, Buat KTP Indonesia, E-KTP Generator Indonesia">
    <meta name="author" content="YoshCasaster">

    <!-- Set tema sebelum render untuk mencegah kedipan -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>

    <!-- Fonts & icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <link rel="stylesheet" href="/css/style.css?v=10">
</head>

<body>
    <header class="topbar">
        <a class="brand" href="/"><i class="bi bi-person-badge"></i>E-KTP Generator</a>
        <nav class="topbar-actions">
            <a class="navlink" href="/"><i class="bi bi-house-door"></i><span>Beranda</span></a>
            <a class="navlink" href="https://github.com/vathmos/e-ktp-generator" target="_blank"><i class="bi bi-github"></i><span>GitHub</span></a>
            <button type="button" class="icon-btn" id="themeToggle" aria-label="Ganti tema"><i class="bi bi-moon-stars"></i></button>
        </nav>
    </header>

    <main class="page">
        <div class="hero">
            <h1>E-KTP Generator Indonesia</h1>
            <p class="subtitle">Buat E-KTP untuk keperluan edukasi</p>
        </div>

        <form action="/generate" method="POST" enctype="multipart/form-data" id="ektp-form">
            <div class="form-toolbar">
                <button type="button" class="btn" id="randomFill"><i class="bi bi-shuffle"></i>Randomize Data</button>
            </div>
            <!-- Wilayah & NIK -->
            <section class="block">
                <h2 class="block__title"><i class="bi bi-geo-alt"></i>Wilayah &amp; NIK</h2>
                <div class="grid">
                    <div class="field">
                        <label class="label" for="provinsi"><i class="bi bi-geo-alt"></i>Provinsi</label>
                        <input type="text" class="input" id="provinsi" name="provinsi" required>
                    </div>
                    <div class="field">
                        <label class="label" for="kota"><i class="bi bi-building"></i>Kota/Kabupaten</label>
                        <div class="combo">
                            <select class="select" id="jenis_wilayah" name="jenis_wilayah" aria-label="Jenis wilayah">
                                <option value="KOTA" selected>KOTA</option>
                                <option value="KABUPATEN">KABUPATEN</option>
                            </select>
                            <input type="text" class="input" id="kota" name="kota" placeholder="Nama kota/kabupaten" required>
                        </div>
                    </div>
                    <div class="field field--full">
                        <label class="label" for="nik"><i class="bi bi-credit-card-2-front"></i>NIK</label>
                        <input type="text" class="input" id="nik" name="nik" inputmode="numeric" maxlength="16" required>
                        <span class="hint">NIK harus terdiri dari 16 digit angka</span>
                    </div>
                </div>
            </section>

            <!-- Data Pribadi -->
            <section class="block">
                <h2 class="block__title"><i class="bi bi-person"></i>Data Pribadi</h2>
                <div class="grid">
                    <div class="field field--full">
                        <label class="label" for="nama"><i class="bi bi-person"></i>Nama Lengkap</label>
                        <input type="text" class="input" id="nama" name="nama" required>
                    </div>
                    <div class="field">
                        <label class="label" for="ttl"><i class="bi bi-calendar-event"></i>Tempat, Tanggal Lahir</label>
                        <input type="text" class="input" id="ttl" name="ttl" placeholder="Jakarta, 01-01-2000" required>
                    </div>
                    <div class="field">
                        <label class="label" for="jenis_kelamin"><i class="bi bi-gender-ambiguous"></i>Jenis Kelamin</label>
                        <select class="select" id="jenis_kelamin" name="jenis_kelamin" required>
                            <option value="">Pilih...</option>
                            <option value="laki-laki">Laki-laki</option>
                            <option value="perempuan">Perempuan</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="golongan_darah"><i class="bi bi-droplet"></i>Golongan Darah</label>
                        <select class="select" id="golongan_darah" name="golongan_darah">
                            <option value="">Pilih...</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="AB">AB</option>
                            <option value="O">O</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="agama"><i class="bi bi-book"></i>Agama</label>
                        <select class="select" id="agama" name="agama" required>
                            <option value="">Pilih...</option>
                            <option value="islam">Islam</option>
                            <option value="kristen">Kristen</option>
                            <option value="katolik">Katolik</option>
                            <option value="hindu">Hindu</option>
                            <option value="buddha">Buddha</option>
                            <option value="konghucu">Konghucu</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="status"><i class="bi bi-heart"></i>Status Perkawinan</label>
                        <select class="select" id="status" name="status" required>
                            <option value="">Pilih...</option>
                            <option value="belum menikah">Belum Menikah</option>
                            <option value="menikah">Menikah</option>
                            <option value="cerai hidup">Cerai Hidup</option>
                            <option value="cerai mati">Cerai Mati</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="label" for="pekerjaan"><i class="bi bi-briefcase"></i>Pekerjaan</label>
                        <input type="text" class="input" id="pekerjaan" name="pekerjaan" required>
                    </div>
                    <div class="field">
                        <label class="label" for="kewarganegaraan"><i class="bi bi-flag"></i>Kewarganegaraan</label>
                        <select class="select" id="kewarganegaraan" name="kewarganegaraan" required>
                            <option value="wni">WNI</option>
                            <option value="wna">WNA</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- Alamat -->
            <section class="block">
                <h2 class="block__title"><i class="bi bi-house"></i>Alamat</h2>
                <div class="grid">
                    <div class="field field--full">
                        <label class="label" for="alamat"><i class="bi bi-house"></i>Alamat</label>
                        <input type="text" class="input" id="alamat" name="alamat" required>
                    </div>
                    <div class="field">
                        <label class="label" for="rt_rw"><i class="bi bi-signpost-split"></i>RT/RW</label>
                        <input type="text" class="input" id="rt_rw" name="rt_rw" placeholder="000/000" required>
                    </div>
                    <div class="field">
                        <label class="label" for="kel_desa"><i class="bi bi-geo"></i>Kelurahan/Desa</label>
                        <input type="text" class="input" id="kel_desa" name="kel_desa" required>
                    </div>
                    <div class="field">
                        <label class="label" for="kecamatan"><i class="bi bi-pin-map"></i>Kecamatan</label>
                        <input type="text" class="input" id="kecamatan" name="kecamatan" required>
                    </div>
                </div>
            </section>

            <!-- Dokumen -->
            <section class="block">
                <h2 class="block__title"><i class="bi bi-card-text"></i>Dokumen</h2>
                <div class="grid">
                    <div class="field">
                        <label class="label" for="masa_berlaku"><i class="bi bi-clock-history"></i>Masa Berlaku</label>
                        <input type="text" class="input" id="masa_berlaku" name="masa_berlaku" value="SEUMUR HIDUP" required>
                    </div>
                    <div class="field">
                        <label class="label" for="terbuat"><i class="bi bi-calendar-check"></i>Tanggal Pembuatan</label>
                        <input type="text" class="input" id="terbuat" name="terbuat" value="<%= new Date().toLocaleDateString('id-ID') %>" required>
                    </div>
                </div>
            </section>

            <!-- Foto & Tanda Tangan -->
            <section class="block">
                <h2 class="block__title"><i class="bi bi-image"></i>Foto &amp; Tanda Tangan</h2>
                <div class="grid">
                    <div class="field">
                        <label class="label" for="pas_photo"><i class="bi bi-camera"></i>Pas Foto</label>
                        <div class="dropzone" id="dropzone">
                            <input type="file" id="pas_photo" name="pas_photo" accept="image/*" class="sr-only" required>
                            <input type="hidden" id="pas_photo_data" name="pas_photo_data">
                            <div class="dropzone__prompt" id="dropzonePrompt">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <p><strong>Seret &amp; letakkan</strong> foto di sini<br>atau <span class="link">klik untuk memilih</span></p>
                                <span class="hint">Nanti disesuaikan ke rasio 3:4</span>
                            </div>
                            <div id="photo-preview-container" class="photo-preview"></div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label" for="signatureCanvas"><i class="bi bi-pen"></i>Tanda Tangan</label>
                        <div class="sigpad">
                            <canvas id="signatureCanvas" width="600" height="200"></canvas>
                            <input type="hidden" id="signature_data" name="tanda_tangan">
                            <div class="sigpad__bar">
                                <button type="button" class="btn btn-sm" id="clearSignature"><i class="bi bi-eraser"></i>Hapus</button>
                                <span class="hint">Klik dan geser untuk membuat tanda tangan</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                    <i class="bi bi-file-earmark-person"></i>Generate E-KTP
                </button>
            </div>

            <div class="loading" id="loadingIndicator">
                <div class="spinner"></div>
                <p>Sedang membuat E-KTP Anda...</p>
            </div>
        </form>
    </main>

    <footer class="footer">
        Created by <a href="https://github.com/YoshCasaster" target="_blank">CodeFomo &amp; Yosh Casaster</a> &middot; Enhanced by <a href="https://github.com/vathmos" target="_blank">vathmos</a>
    </footer>

    <!-- Toast notifications container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Modal cropper foto (rasio 3:4) -->
    <div class="modal" id="cropperModal" aria-hidden="true">
        <div class="modal__panel" role="dialog" aria-modal="true" aria-label="Sesuaikan pas foto">
            <div class="modal__head">
                <h3><i class="bi bi-crop"></i>Sesuaikan Pas Foto (3:4)</h3>
                <button type="button" class="modal__close" data-close aria-label="Tutup">&times;</button>
            </div>
            <div class="modal__body">
                <div class="cropper-stage">
                    <img id="cropperImage" src="" alt="Area crop">
                </div>
                <p class="hint"><i class="bi bi-info-circle"></i> Geser untuk memindahkan, scroll / cubit untuk zoom. Rasio terkunci 3:4.</p>
            </div>
            <div class="modal__foot">
                <button type="button" class="btn" data-close><i class="bi bi-x-lg"></i>Batal</button>
                <button type="button" class="btn btn-primary" id="cropSave"><i class="bi bi-check2"></i>Gunakan Foto</button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script src="/js/script.js?v=10"></script>
</body>
</html>
