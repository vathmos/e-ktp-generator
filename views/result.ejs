<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-KTP Berhasil Dibuat - E-KTP Generator Indonesia</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css?v=3">
</head>

<body>
    <header class="topbar">
        <a class="brand" href="/"><i class="bi bi-person-badge"></i>E-KTP Generator</a>
        <nav class="topbar-actions">
            <a class="navlink" href="/"><i class="bi bi-house-door"></i><span>Beranda</span></a>
            <a class="navlink" href="https://github.com/YoshCasaster" target="_blank"><i class="bi bi-github"></i><span>GitHub</span></a>
            <button type="button" class="icon-btn" id="themeToggle" aria-label="Ganti tema"><i class="bi bi-moon-stars"></i></button>
        </nav>
    </header>

    <main class="page">
        <div class="hero">
            <h1><i class="bi bi-check-circle" style="color: var(--success);"></i> E-KTP Berhasil Dibuat</h1>
            <p class="subtitle">Unduh hasilnya atau buat E-KTP baru</p>
        </div>

        <section class="block centered" style="margin: 0 auto;">
            <img src="<%= imgPath %>" alt="E-KTP" class="result-img">
            <div>
                <span class="badge"><i class="bi bi-info-circle"></i>Hanya untuk Edukasi</span>
            </div>

            <div class="result-actions">
                <a href="<%= imgPath %>" download="ektp_<%= data.nama.replace(/\s+/g, '_').toLowerCase() %>.png" class="btn btn-primary">
                    <i class="bi bi-download"></i>Download E-KTP
                </a>
                <a href="/" class="btn"><i class="bi bi-plus-circle"></i>Buat E-KTP Baru</a>
            </div>

            <div class="note">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span><strong>Catatan:</strong> E-KTP ini dibuat hanya untuk tujuan edukasi dan tidak memiliki nilai hukum. Dilarang menggunakan untuk tindakan penipuan atau melanggar hukum.</span>
            </div>
        </section>
    </main>

    <footer class="footer">
        Created by <a href="https://github.com/YoshCasaster" target="_blank">CodeFomo &amp; Yosh Casaster</a>
    </footer>

    <script src="/js/script.js?v=3"></script>
</body>
</html>
